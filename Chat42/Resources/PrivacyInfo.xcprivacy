<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest.

  NSPrivacyCollectedDataTypes is empty on purpose, and that is the accurate
  declaration: Chat42 has no backend and no analytics. Conversations are written
  only to Application Support on this Mac. Prompts do travel to whichever endpoint
  the user configures (Ollama, a gateway) — but "collection" in this manifest means
  data gathered by *this app's developer*, which is none. The previous version of
  this file declared UserContent and Identifiers as collected, contradicting the
  README's privacy policy and describing behaviour the app does not have.

  It also used key names that are not in Apple's schema
  (NSPrivacyCollectedData / NSPrivacyCollectedDataCategory /
  NSPrivacyCollectedDataPurpose), so it would not have validated.

  Required-reason APIs: the app reads and writes its own UserDefaults. It does not
  read file timestamps, disk space, boot time, or the active keyboard list, so no
  other categories are declared.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access to the app's own defaults, no group container. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
