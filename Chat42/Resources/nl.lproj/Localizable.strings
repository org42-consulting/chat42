/* ─────────────────────────────────────────────────────────────────────────────
   Hulpvenster (Help → Chat42 Help, ⌘?).

   Deze tekst wordt als inline markdown weergegeven: `backticks` markeren
   commando's en paden, *sterretjes* geven nadruk. Menupaden met ▸ schrijven en
   toetscombinaties buiten de vertaalde tekst laten — de lijst met sneltoetsen
   komt letterlijk uit HelpView.
   ───────────────────────────────────────────────────────────────────────────── */
"help.window.title" = "Chat42 Help";
"help.menu.item" = "Chat42 Help";

/* Help – Aan de slag */
"help.start.title" = "Aan de slag";
"help.start.lead" = "Chat42 is een gespreksvenster voor een taalmodel. Dat model draait op deze Mac of op een server die je zelf aanwijst, en welk model antwoordt bepaal je zelf — er zit geen account en geen abonnement tussen.";
"help.start.first.title" = "Je eerste antwoord";
"help.start.first.body" = "De kortste route draait volledig op deze Mac en vraagt geen voorbereiding.";
"help.start.step1" = "Open Instellingen";
"help.start.step1.detail" = "Druk op `⌘,` of klik op het tandwiel onderaan de navigatiekolom en kies het paneel MLX.";
"help.start.step2" = "Download een model";
"help.start.step2.detail" = "Begin bovenaan de lijst. Qwen 3 0.6B is ongeveer 350 MB en is binnen enkele seconden klaar; de modellen verderop antwoorden beter en zijn veel groter. Een lopende download kun je annuleren.";
"help.start.step3" = "Laad het";
"help.start.step3.detail" = "Klik op Laden en sluit Instellingen. Downloaden zet het model op schijf, laden zet het in het geheugen — en dat laatste maakt het pas bruikbaar.";
"help.start.step4" = "Stel een vraag";
"help.start.step4.detail" = "⌘N begint een gesprek. Controleer of MLX geselecteerd staat in de balk boven het gesprek, typ een vraag en druk op Return.";
"help.start.note" = "Het bolletje naast de modelnaam is de status van de backend. Groen betekent dat er antwoord kwam, oranje dat de backend bereikbaar is maar geen modellen heeft, rood dat er geen verbinding was.";

/* Help – Backends */
"help.backends.title" = "Backends";
"help.backends.lead" = "Drie soorten backend, te kiezen in de balk boven een gesprek of via het menu Model. De keuze blijft bewaard tussen sessies, en elk gesprek legt vast welk model het daadwerkelijk heeft bediend.";
"help.backends.ollama" = "Ollama";
"help.backends.ollama.detail" = "Modellen die je met het commando `ollama` hebt opgehaald, aangeboden via HTTP — `http://localhost:11434` tenzij je dat wijzigt. Chat42 toont wat Ollama meldt en stuurt afbeeldingen naar de modellen die die aankunnen.";
"help.backends.mlx" = "MLX";
"help.backends.mlx.detail" = "Apple's eigen framework, dat het model direct op Apple Silicon uitvoert. De modellen komen uit een samengestelde lijst, worden van Hugging Face gedownload en blijven op deze Mac. Er is er één tegelijk geladen. Vereist een M-chip; er is geen Intel-variant.";
"help.backends.gateway" = "Gateway";
"help.backends.gateway.detail" = "Elk OpenAI-compatibel eindpunt — LiteLLM, OpenAI, OpenRouter, Jan. De modellenlijst is wat het eindpunt teruggeeft op `/v1/models`. Modellen die afbeeldingen maken staan onder een eigen kop, omdat ze met een plaatje antwoorden in plaats van met tekst.";
"help.backends.note" = "MLX neemt geen afbeeldingsbijlagen aan. Stuur die naar Ollama of naar een gateway-model dat vision ondersteunt.";

/* Help – Gesprekken */
"help.conv.title" = "Gesprekken";
"help.conv.lead" = "Elk gesprek blijft bewaard. De navigatiekolom zet het meest recente bovenaan, en elke regel toont de backend en het model die erin geantwoord hebben.";
"help.conv.new" = "Nieuw gesprek";
"help.conv.new.detail" = "⌘N, of het potlood bovenaan de navigatiekolom. Archief ▸ Nieuw gesprek uit sjabloon begint een gesprek dat al is ingesteld.";
"help.conv.titles" = "Titels";
"help.conv.titles.detail" = "Overgenomen uit de eerste woorden die je stuurt. Klik rechts op een regel en kies Hernoemen om er zelf een te schrijven.";
"help.conv.search" = "Zoeken";
"help.conv.search.detail" = "⌘F zet de aandacht in het zoekveld. Er wordt gezocht in de titel en in alles wat er gezegd is; zit de treffer in het gesprek en niet in de titel, dan toont de regel de gevonden passage.";
"help.conv.switch" = "Wisselen";
"help.conv.switch.detail" = "⌘1 tot ⌘9 springen direct naar een gesprek op die positie. ⌥⌘↓ en ⌥⌘↑ lopen door de lijst en beginnen aan het eind weer vooraan.";
"help.conv.clear" = "Wissen";
"help.conv.clear.detail" = "Het prullenbakje in de gespreksbalk maakt het gesprek leeg maar behoudt het gesprek zelf, samen met de instructies waarmee het begon. Er wordt eerst om bevestiging gevraagd, en het kan niet ongedaan worden gemaakt.";
"help.conv.delete" = "Verwijderen";
"help.conv.delete.detail" = "Klik rechts op een regel en kies Verwijderen. Afbeeldingen die het gesprek heeft gemaakt gaan mee.";
"help.conv.export" = "Exporteren";
"help.conv.export.detail" = "⌘E, of het deelsymbool in de gespreksbalk, schrijft het hele gesprek naar een Markdown-bestand — de instructies, beide kanten van elke beurt en de namen van eventuele bijlagen.";
"help.conv.note" = "Antwoorden komen per gesprek binnen. Een antwoord in een gesprek waar je niet naar kijkt blokkeert het tekstvak elders niet en wordt ook niet afgebroken als je wegschakelt.";

