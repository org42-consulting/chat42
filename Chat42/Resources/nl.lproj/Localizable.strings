/* Help – Privacy en gegevens */
"help.priv.title" = "Privacy en gegevens";
"help.priv.lead" = "Chat42 heeft geen account, geen eigen server en geen analytics. De app vraagt het eindpunt dat jij hebt ingesteld, en verder niets.";
"help.priv.where" = "Waar dingen staan";
"help.priv.path.conversations" = "Alle gesprekken, weggeschreven een halve seconde na de laatste wijziging en opnieuw bij afsluiten.";
"help.priv.path.images" = "Afbeeldingen die een model heeft gemaakt. Verdwijnen samen met het bericht waarin ze staan.";
"help.priv.path.models" = "Gedownloade MLX-modellen. Een model verwijderen in Instellingen haalt het hier weg.";
"help.priv.keychain" = "De API-sleutel";
"help.priv.keychain.detail" = "De gateway-sleutel staat in de sleutelhanger van macOS, nooit in de voorkeuren. Hij wordt kort na het starten gelezen en niet tijdens het starten, zodat een vraag van de sleutelhanger over een lopende app verschijnt in plaats van het eerste beeld op te houden.";
"help.priv.attachments" = "Bijlagen";
"help.priv.attachments.detail" = "De bytes van een bestand dat je bijvoegt komen nooit op schijf. De tekst die eruit is gehaald wel, als onderdeel van het gesprek, want dat is wat een vervolgvraag laat werken.";
"help.priv.local" = "Lokale backends";
"help.priv.local.detail" = "Ollama en MLX antwoorden op deze Mac. Niets van wat je typt verlaat hem.";
"help.priv.remote" = "Gateways";
"help.priv.remote.detail" = "Een gateway is de server van iemand anders, ook een gateway op `localhost` die doorstuurt naar een API elders. Wat je daarheen stuurt valt onder het beleid aan de andere kant, niet onder dit beleid.";

/* Help – Problemen oplossen */
"help.tr.title" = "Problemen oplossen";
"help.tr.lead" = "Wat de meldingen betekenen, en wat je eraan doet.";
"help.tr.ollama_down" = "Ollama is niet actief";
"help.tr.ollama_down.detail" = "Start het met `ollama serve`, controleer daarna de URL in Instellingen ▸ Ollama en druk op Verbinding testen.";
"help.tr.no_models" = "Geen modellen geïnstalleerd";
"help.tr.no_models.detail" = "Haal er een op aan de Ollama-kant: `ollama pull llama3.2`. De lijst pikt het zelf op, of direct met ⇧⌘R.";
"help.tr.mlx_intel" = "MLX vereist Apple Silicon";
"help.tr.mlx_intel.detail" = "Er is geen Intel-route voor MLX. Gebruik op een Intel-Mac Ollama of een gateway.";
"help.tr.mlx_load" = "Een MLX-model laadt niet";
"help.tr.mlx_load.detail" = "Een model moet klaar zijn met downloaden voordat het kan laden, en een groot model vraagt het geheugen dat erbij hoort — het model van 70B is 40 GB op schijf en wil aanzienlijk meer dan dat vrij hebben.";
"help.tr.gateway_auth" = "Authenticatie mislukt";
"help.tr.gateway_auth.detail" = "Controleer de API-sleutel in Instellingen ▸ Gateway en druk op Verbinding testen. De sleutel wordt kort na het starten uit de sleutelhanger gelezen, dus de eerste poging na een installatie of een nieuwe build kan om toegang tot de sleutelhanger vragen.";
"help.tr.temperature" = "Een model weigerde de temperatuurinstelling";
"help.tr.temperature.detail" = "Sommige reasoning-modellen accepteren geen expliciete temperatuur. Chat42 merkt dat, laat de instelling weg en stuurt het verzoek opnieuw — er gaat niets verloren, en de melding legt uit waarom het antwoord je temperatuur negeerde.";
"help.tr.forgotten" = "Eerdere beurten worden vergeten";
"help.tr.forgotten.detail" = "Het contextbudget is vol en de oudste beurten vallen eruit. Verhoog Contextgrootte in Instellingen ▸ Algemeen, of begin een nieuw gesprek.";
"help.tr.gatekeeper" = "macOS wil de app niet openen";
"help.tr.gatekeeper.detail" = "De build is niet genotariseerd. Gebruik een release-DMG, of bouw vanaf de broncode en start de app op je eigen machine.";
